{
  "name": "react-honey-hooks",
  "version": "3.1.0",
  "description": "70+ typed, SSR-safe React hooks for React and Next.js: useLocalStorage, useDebouncedValue, useMediaQuery, useClickOutside, URL query params, timers, hotkeys, element size, browser APIs and more. TypeScript, zero dependencies, tree-shakeable.",
  "license": "MIT",
  "author": "Abdelfatah Ashour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelfatah-ashour/react-honey-hooks.git"
  },
  "bugs": "https://github.com/abdelfatah-ashour/react-honey-hooks/issues",
  "homepage": "https://github.com/abdelfatah-ashour/react-honey-hooks#readme",
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "react-hook",
    "react-hooks-library",
    "nextjs",
    "next.js",
    "typescript",
    "countdown",
    "click-outside",
    "query-params",
    "local-storage",
    "media-query",
    "debounce",
    "hotkeys",
    "intersection-observer",
    "clipboard",
    "session-storage",
    "throttle",
    "resize-observer",
    "long-press",
    "scroll-lock",
    "undo-redo",
    "async",
    "focus-trap",
    "geolocation",
    "fullscreen",
    "wake-lock",
    "drag-and-drop",
    "cookies",
    "counter",
    "controlled-component",
    "selection",
    "dynamic-list",
    "use-latest",
    "stable-callback",
    "deep-compare",
    "lifecycle",
    "hooks-library",
    "custom-hooks",
    "next",
    "app-router",
    "ssr",
    "server-side-rendering",
    "typescript-hooks",
    "tree-shakeable",
    "zero-dependency",
    "use-local-storage",
    "use-debounce",
    "use-media-query",
    "use-click-outside",
    "use-interval",
    "use-window-size",
    "use-query-params",
    "window-size",
    "element-size",
    "keyboard-shortcuts",
    "copy-to-clipboard",
    "dark-mode",
    "idle"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "tsup && vitest run --project e2e --project e2e-exclusive",
    "test:bundle": "tsup && vitest run --project bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:e2e && npm run test:bundle",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "vitest-browser-react": "^2.3.0"
  }
}
